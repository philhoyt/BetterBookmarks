{
    "name": "better-bookmarks",
    "version": "1.2.2",
    "description": "A link card block with Open Graph preview support.",
    "scripts": {
        "build": "wp-scripts build --webpack-src-dir=src --output-path=build",
        "start": "wp-scripts start --webpack-src-dir=src --output-path=build",
        "lint:js": "wp-scripts lint-js src",
        "lint:css": "wp-scripts lint-style 'src/**/*.css'",
        "lint": "npm run lint:js && npm run lint:css",
        "test:js": "wp-scripts test-unit-jest",
        "test:php": "vendor/bin/phpunit",
        "test": "npm run test:js && npm run test:php",
        "plugin-zip": "wp-scripts plugin-zip"
    },
    "files": [
        "better-bookmarks.php",
        "readme.txt",
        "build",
        "includes",
        "lib"
    ],
    "devDependencies": {
        "@babel/core": "^7.25.7",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@wordpress/api-fetch": "^8.1.0",
        "@wordpress/babel-preset-default": "^8.55.0",
        "@wordpress/block-editor": "^20.0.0",
        "@wordpress/blocks": "^17.1.0",
        "@wordpress/components": "^44.0.0",
        "@wordpress/data": "^11.1.0",
        "@wordpress/element": "^10.1.0",
        "@wordpress/i18n": "^7.1.0",
        "@wordpress/jest-preset-default": "^14.2.0",
        "@wordpress/primitives": "^5.1.0",
        "@wordpress/scripts": "^37.1.0",
        "babel-jest": "^30.5.0",
        "eslint-plugin-jest": "^29.17.0",
        "jest": "^30.5.0",
        "jest-environment-jsdom": "^30.5.0"
    }
}
